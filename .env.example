# Set these environment variables in your terminal; .env is not automatically loaded.
OJ_DATA_DIR=./data
OJ_API_URL=http://127.0.0.1:8001
OJ_RUNNER=local
OJ_COOKIE_SECURE=0
# Only for explicitly trusted local model providers:
OJ_AI_ALLOW_LOCAL=0
# Optional Fernet key. If absent, generated at data/model-secret.key.
# OJ_ENCRYPTION_KEY=
